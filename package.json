{
  "name": "glitch-cinema",
  "version": "0.1.0",
  "private": true,
  "description": "Kahoot-style multiplayer interactive tech-horror film: host screen + 5 mobile voters + story node editor",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c red,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=server --watch-path=shared server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "event": "vite build && node server/index.js --tunnel",
    "test": "node --test test/*.test.js",
    "simulate": "node scripts/simulate.js",
    "mock:clips": "bash scripts/make-mock-clips.sh"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.0",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "vite": "^5.4.0"
  }
}
